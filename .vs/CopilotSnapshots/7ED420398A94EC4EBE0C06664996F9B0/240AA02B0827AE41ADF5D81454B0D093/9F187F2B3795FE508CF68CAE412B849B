# escape=`

FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["cmd", "/S", "/C"]

# Copy Build Tools installer
ADD https://aka.ms/vs/17/release/vs_BuildTools.exe C:\TEMP\vs_buildtools.exe

# Install Visual Studio C++ Build Tools
RUN C:\TEMP\vs_buildtools.exe --quiet --wait --norestart --nocache --installPath C:\BuildTools --add Microsoft.VisualStudio.Workload.VCTools;includeRecommended --add Microsoft.VisualStudio.Component.Windows11SDK.22621 || IF "%ERRORLEVEL%"=="3010" EXIT 0

# Verify installation
RUN dir C:\BuildTools\Common7\Tools\VsDevCmd.bat

WORKDIR C:\src

COPY src src

RUN mkdir C:\out

CMD call "C:\BuildTools\Common7\Tools\VsDevCmd.bat" && cl /EHsc src\main.cpp /Fe:C:\out\hello.exe